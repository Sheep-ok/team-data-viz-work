        region: [
          '苏派', '皖派', '晋派', '京派', '闽派', '粤派', '川派', '滇黔�?, '西北�?,
          '陕派', '西南�?, '全派系通用', '南方各派�?,
        ],
        social: [
          '体现身份', '名贵', '装饰�?, '装饰精美', '易雕�?, '就地取材', '预算有限', '手艺核心',
        ],
      };

      const selectedTags = {
        function: new Set(),
        region: new Set(),
        social: new Set(),
      };

      const MATERIAL_CATEGORY_CLASS = {
        木材: 'cat-wood',
        石材: 'cat-stone',
        砖材: 'cat-brick',
        土材: 'cat-earth',
        灰材: 'cat-lime',
        竹材: 'cat-bamboo',
        瓦片: 'cat-tile',
      };

      const MATERIAL_TAG_MAP = {
        杉木: { function: ['结构承重', '抗震�?], region: ['苏派', '皖派', '川派', '滇黔�?], social: ['手艺核心'], feature: ['主力用材', '易加�?, '轻质'] },
        松木: { function: ['结构承重', '耐干�?], region: ['京派', '晋派'], social: [], feature: ['北方标配', '纹理�?] },
        楠木: { function: ['结构承重', '防虫防蛀'], region: ['皖派', '苏派', '粤派'], social: ['体现身份', '名贵'], feature: ['宗祠用材'] },
        柏木: { function: ['防潮耐腐'], region: ['川派', '滇黔�?], social: [], feature: ['稳定�?, '湿热适配', '山区常用'] },
        樟木: { function: ['防虫防蛀', '防霉�?], region: ['闽派', '粤派'], social: ['装饰�?], feature: ['自带香气', '门窗隔断'] },
        榆木: { function: ['结构承重'], region: ['晋派', '京派'], social: [], feature: ['坚韧抗压', '硬木', '北方梁枋'] },

        花岗�? { function: ['结构承重', '防潮耐腐', '耐盐�?], region: ['闽派', '粤派'], social: [], feature: ['坚硬', '耐风�?, '沿海标配'] },
        青石: { function: ['辅助支撑', '易雕�?], region: ['苏派', '皖派', '京派', '晋派'], social: ['装饰�?, '易雕�?], feature: ['细腻', '通用石材'] },
        条石: { function: ['结构承重', '防潮耐腐'], region: ['晋派', '苏派', '川派'], social: [], feature: ['规整', '墙基专用'] },
        毛石: { function: ['辅助支撑', '防潮耐腐'], region: ['川派', '滇黔�?], social: ['就地取材', '预算有限'], feature: ['粗粝'] },
        汉白�? { function: [], region: ['京派', '晋派'], social: ['装饰�?, '体现身份', '名贵'], feature: ['洁白', '皇家/富商'] },
        页岩: { function: ['屋面排水', '围护遮挡', '轻质'], region: ['滇黔�?, '川派'], social: ['就地取材'], feature: ['轻薄', '石片�?] },

        青砖: { function: ['围护遮挡', '防火�?, '保温御寒'], region: ['全派系通用'], social: [], feature: ['核心墙材', '经久耐用'] },
        方砖: { function: ['铺地耐磨', '结构承重'], region: ['苏派', '京派'], social: [], feature: ['平整', '高级室内'] },
        条砖: { function: ['围护遮挡', '结构辅助'], region: ['苏派', '闽派'], social: [], feature: ['基础用砖', '隔墙'] },
        望砖: { function: ['屋面辅助', '装饰�?], region: ['苏派', '皖派', '粤派'], social: ['装饰�?], feature: ['轻薄', '遮挡'] },
        砖雕用料�? { function: ['装饰�?, '易雕�?], region: ['皖派', '晋派'], social: ['手艺核心', '体现身份', '易雕�?], feature: ['细腻'] },

        夯土: { function: ['保温御寒', '热惰�?, '围护遮挡'], region: ['闽派', '陕派', '滇黔�?], social: ['就地取材'], feature: ['厚重', '生态足�?] },
        生土�? { function: ['保温御寒', '围护遮挡'], region: ['京派', '晋派', '西北�?], social: ['预算有限'], feature: ['非承�?] },
        草筋�? { function: ['围护遮挡', '抗震�?, '抗裂�?], region: ['川派', '滇黔�?], social: [], feature: ['韧�?, '抗裂', '山区民居'] },
        三合�? { function: ['防潮耐腐', '结构支撑'], region: ['闽派', '粤派'], social: [], feature: ['硬化地面', '沿海防潮'] },

        石灰灰浆: { function: ['黏合勾缝', '防火�?], region: ['全派系通用'], social: [], feature: ['基础灰材'] },
        纸筋�? { function: ['装饰�?, '密封防风'], region: ['苏派', '京派'], social: ['装饰�?], feature: ['洁白细腻', '内墙抹灰'] },
        贝壳�? { function: ['防潮耐腐', '耐盐�?, '黏合勾缝'], region: ['粤派', '闽派'], social: [], feature: ['地域特色', '高黏�?] },
        麻刀�? { function: ['抗裂�?, '辅助支撑'], region: ['川派', '京派'], social: [], feature: ['韧�?, '易损部位'] },

        毛竹: { function: ['辅助支撑', '通风透气', '透气�?], region: ['川派', '滇黔�?, '粤派'], social: ['就地取材'], feature: ['轻便', '骨架'] },
        '淡竹 / 水竹': { function: ['围护遮挡', '通风透气', '透气�?, '轻质'], region: ['苏派', '川派'], social: [], feature: ['编织', '轻质隔断'] },
        竹篾: { function: ['抗裂�?, '结构辅助'], region: ['皖派', '西南�?], social: [], feature: ['柔韧', '抹灰骨架'] },
        楠竹: { function: ['结构支撑', '耐磨�?], region: ['闽派', '滇黔�?], social: [], feature: ['坚硬', '地板楼梯'] },

        小青�? { function: ['屋面排水', '通风透气'], region: ['南方各派�?], social: [], feature: ['南方之魂', '铺设灵活'] },
        筒瓦: { function: ['屋面排水', '密封防漏'], region: ['京派', '晋派', '粤派'], social: ['体现身份'], feature: ['等级象征', '厚重'] },
        板瓦: { function: ['屋面排水', '保温御寒'], region: ['京派', '晋派'], social: [], feature: ['北方厚重', '稳固'] },
        滴水�? { function: ['屋面排水', '装饰�?], region: ['苏派', '皖派'], social: ['装饰�?], feature: ['引导雨水', '檐口细节'] },
      };

      function loadAdaptiveImages() {
        const images = document.querySelectorAll('img[data-src-base]');

        function applyImageOrientation(img) {
          const wrapper = img.closest('.roof-image, .gable-image');
          if (!wrapper) return;

          const shouldAdapt = wrapper.closest('#wudinggouzao, #zhutigoujia');
          if (!shouldAdapt) return;

          wrapper.classList.remove('is-landscape', 'is-portrait');

          if (img.naturalWidth > img.naturalHeight) {
            wrapper.classList.add('is-landscape');
          } else {
            wrapper.classList.add('is-portrait');
          }
        }

        images.forEach((img) => {
          const base = (img.dataset.srcBase || '').trim();
          if (!base) return;

          const fallbackRaw = (img.dataset.srcFallbacks || '').trim();
          const names = [
            base,
            ...fallbackRaw
              .split(',')
              .map((item) => item.trim())
              .filter(Boolean),
          ];

          const candidates = [];
          names.forEach((name) => {
            EXTENSIONS.forEach((ext) => {
              candidates.push(name + '.' + ext);
            });
          });

          let index = 0;
          const tryNext = function () {
            if (index >= candidates.length) {
              const parent = img.parentElement;
              if (parent) {
                parent.innerHTML = '<div class="image-slot">图片待补�?/div>';
              } else {
                img.style.display = 'none';
              }
              return;
            }
            img.src = candidates[index++];
          };

          img.onerror = tryNext;
          img.onload = function () {
            applyImageOrientation(img);
          };
          tryNext();
        });
      }

      function showSection(sectionId) {
        sections.forEach((section) => {
          section.classList.toggle('active', section.id === sectionId);
        });

        navLinks.forEach((link) => {
          link.classList.toggle('active', link.dataset.target === sectionId);
        });
      }

      function hideAllPanels() {
        panels.forEach((panel) => panel.classList.remove('visible'));
      }

      function initCraftPanel() {
        const craftContainer = document.getElementById('jianzaogongyi');
        if (!craftContainer || craftContainer.dataset.initialized === 'true') {
          return;
        }

        const nodesContainer = craftContainer.querySelector('.craft-flow-nodes');
        const linesSvg = craftContainer.querySelector('.craft-flow-lines');
        const nodesData = [
          { id: 'gujia', text: '骨架乾坤', x: 100, y: 50 },
          { id: 'mugoujia', text: '木构�?, x: 300, y: 100 },
          { id: 'sunmao', text: '榫卯', x: 500, y: 50 },
          { id: 'taiji', text: '台基与柱础', x: 700, y: 120 },
          { id: 'fuwa', text: '覆瓦筑垣', x: 900, y: 50 },
          { id: 'zhuanqie', text: '砖切与叠�?, x: 1100, y: 150 },
          { id: 'hangtu', text: '夯土', x: 1300, y: 80 },
          { id: 'wumian', text: '屋面瓦作', x: 1500, y: 180 },
          { id: 'fangshui', text: '防水排水', x: 1700, y: 100 },
          { id: 'menchuang', text: '韵梁门庭', x: 1900, y: 200 },
          { id: 'sandiao', text: '三雕', x: 2100, y: 120 },
          { id: 'caihui', text: '彩绘与油�?, x: 2300, y: 220 },
          { id: 'pudi', text: '铺地', x: 2500, y: 150 },
        ];

        const connections = [
          ['gujia', 'mugoujia'],
          ['mugoujia', 'sunmao'],
          ['sunmao', 'taiji'],
          ['taiji', 'fuwa'],
          ['fuwa', 'zhuanqie'],
          ['zhuanqie', 'hangtu'],
          ['hangtu', 'wumian'],
          ['wumian', 'fangshui'],
          ['fangshui', 'menchuang'],
          ['menchuang', 'sandiao'],
          ['sandiao', 'caihui'],
          ['caihui', 'pudi'],
        ];

        const nodeElements = {};

        nodesData.forEach(data => {
          const node = document.createElement('div');
          node.className = 'craft-node';
          node.id = `craft-node-${data.id}`;
          node.textContent = data.text;
          node.style.left = `${data.x}px`;
          node.style.top = `${data.y}px`;
          nodesContainer.appendChild(node);
          nodeElements[data.id] = node;
        });

        connections.forEach(conn => {
          const startNode = nodeElements[conn[0]];
          const endNode = nodeElements[conn[1]];
          if (startNode && endNode) {
            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('class', 'craft-flow-line');
            
            const startRect = startNode.getBoundingClientRect();
            const endRect = endNode.getBoundingClientRect();
            const containerRect = craftContainer.getBoundingClientRect();

            // We calculate positions relative to the container, not the viewport
            const x1 = startNode.offsetLeft + startNode.offsetWidth / 2;
            const y1 = startNode.offsetTop + startNode.offsetHeight / 2;
            const x2 = endNode.offsetLeft + endNode.offsetWidth / 2;
            const y2 = endNode.offsetTop + endNode.offsetHeight / 2;

            line.setAttribute('x1', x1);
            line.setAttribute('y1', y1);
            line.setAttribute('x2', x2);
            line.setAttribute('y2', y2);
            linesSvg.appendChild(line);
          }
        });

        craftContainer.dataset.initialized = 'true';
      }

      function openPanel(panelId) {
        const targetPanel = document.getElementById(panelId);
        if (!targetPanel) return;

        hideAllPanels();
        targetPanel.classList.add('visible');
        document.body.classList.add('panel-mode');

        if (panelId === 'buildingStructurePanel') {
          showSection('zhutigoujia');
        }
        if (panelId === 'buildingCraftPanel') {
          initCraftPanel();
        }
      }

      function closePanels() {
        hideAllPanels();
        document.body.classList.remove('panel-mode');
        if (materialModal) {
          materialModal.hidden = true;
        }
      }
      
      function openMaterialModal(categoryName, item) {
        if (!materialModal || !materialModalTitle || !materialModalIntro || !materialModalRepresent || !materialModalTags) {
          return;
        }
        const itemTags = MATERIAL_TAG_MAP[item.name] || { function: [], region: [], social: [], feature: [] };
        const tagList = [
          ...itemTags.function,
          ...itemTags.region,
          ...itemTags.social,
          ...itemTags.feature,
        ];
        const uniqueTags = Array.from(new Set(tagList));

        materialModalTitle.textContent = categoryName + ' · ' + item.name;
        materialModalIntro.textContent = '介绍�? + item.intro;
        materialModalRepresent.textContent = '代表�? + item.represent;
        materialModalTags.innerHTML = '';

        uniqueTags.forEach((tag) => {
          const tagNode = document.createElement('span');
          tagNode.className = 'material-modal-tag';
          tagNode.textContent = tag;
          materialModalTags.appendChild(tagNode);
        });

        materialModal.hidden = false;
      }

      function getItemTags(itemName) {
        return MATERIAL_TAG_MAP[itemName] || { function: [], region: [], social: [], feature: [] };
      }

      function matchByDimension(itemTags, dimensionName) {
        const selected = selectedTags[dimensionName];
        if (!selected || selected.size === 0) {
          return true;
        }
        const values = itemTags[dimensionName] || [];
        return values.some((tag) => selected.has(tag));
      }

      function applyMaterialFilters() {
        if (!materialGalaxyBoard) return;

        const clusters = materialGalaxyBoard.querySelectorAll('.material-cluster');
        const selectedRegionValues = Array.from(selectedTags.region);
        const hasAnyFilter = selectedTags.function.size > 0 || selectedTags.region.size > 0 || selectedTags.social.size > 0;

        if (materialClearFilter) {
          materialClearFilter.classList.toggle('visible', hasAnyFilter);
        }

        if (materialRegionWatermark) {
          if (selectedRegionValues.length === 1) {
            materialRegionWatermark.textContent = selectedRegionValues[0];
            materialRegionWatermark.style.display = 'block';
          } else {
            materialRegionWatermark.style.display = 'none';
          }
        }

        clusters.forEach((cluster) => {
          const centerNode = cluster.querySelector('.cluster-center');
          const clusterCategoryClass = cluster.dataset.categoryClass || '';
          const orbitNodes = cluster.querySelectorAll('.cluster-orbit');
          const lines = cluster.querySelectorAll('.cluster-link');
          let hasMatch = !hasAnyFilter;

          orbitNodes.forEach((node, idx) => {
            const line = lines[idx];
            node.classList.remove('filter-hit');
            node.classList.remove('filter-dim');
            if (clusterCategoryClass) {
              node.classList.remove(clusterCategoryClass);
            }
            node.style.pointerEvents = 'auto';
            node.style.opacity = '1';

            const itemTags = node.__materialTags || { function: [], region: [], social: [], feature: [] };
            const isMatch = matchByDimension(itemTags, 'function') && matchByDimension(itemTags, 'region') && matchByDimension(itemTags, 'social');

            if (!hasAnyFilter) {
              if (line) {
                line.classList.remove('active');
                line.style.opacity = '0.16';
              }
              return;
            }

            if (isMatch) {
              hasMatch = true;
              node.classList.add('filter-hit');
              if (clusterCategoryClass) {
                node.classList.add(clusterCategoryClass);
              }
              node.style.opacity = '1';
              if (line) {
                line.classList.add('active');
                line.style.opacity = '0.92';
              }
            } else {
              node.classList.add('filter-dim');
              node.style.pointerEvents = 'none';
              if (line) {
                line.classList.remove('active');
                line.style.opacity = '0.05';
              }
            }
          });

          if (centerNode) {
            centerNode.classList.remove('related', 'unrelated');
            if (hasAnyFilter) {
              centerNode.classList.add(hasMatch ? 'related' : 'unrelated');
            }
          }

          cluster.classList.toggle('search-dim', !hasMatch);
        });
      }

      function createFilterTags() {
        const groups = [
          { key: 'function', mount: functionTagGroup },
          { key: 'region', mount: regionTagGroup },
          { key: 'social', mount: socialTagGroup },
        ];

        groups.forEach((groupItem) => {
          if (!groupItem.mount) return;
          groupItem.mount.innerHTML = '';

          MATERIAL_TAG_OPTIONS[groupItem.key].forEach((tagText) => {
            const tagBtn = document.createElement('button');
            tagBtn.type = 'button';
            tagBtn.className = 'filter-tag';
            tagBtn.textContent = tagText;
            tagBtn.addEventListener('click', function () {
              const targetSet = selectedTags[groupItem.key];
              if (targetSet.has(tagText)) {
                targetSet.delete(tagText);
                tagBtn.classList.remove('active');
              } else {
                targetSet.add(tagText);
                tagBtn.classList.add('active');
              }
              applyMaterialFilters();
            });
            groupItem.mount.appendChild(tagBtn);
          });
        });
      }

      function clearAllMaterialFilters() {
        Object.keys(selectedTags).forEach((key) => {
          selectedTags[key].clear();
        });

        const activeButtons = materialPanel ? materialPanel.querySelectorAll('.filter-tag.active') : [];
        activeButtons.forEach((button) => {
          button.classList.remove('active');
        });

        applyMaterialFilters();
      }

      function initMaterialPanel() {
        if (!materialPanel || !materialGalaxyBoard || materialGalaxyBoard.dataset.initialized === 'true') {
          return;
        }

        createFilterTags();

        if (materialFilterToggle && materialFilterDrawer) {
          materialFilterToggle.addEventListener('click', function () {
            materialFilterDrawer.classList.toggle('expanded');
          });

          document.addEventListener('click', function (event) {
            if (!materialFilterDrawer.classList.contains('expanded')) {
              return;
            }

            const clickInsideDrawer = materialFilterDrawer.contains(event.target);
            if (!clickInsideDrawer) {
              materialFilterDrawer.classList.remove('expanded');
            }
          });
        }

        if (materialClearFilter) {
          materialClearFilter.addEventListener('click', function () {
            clearAllMaterialFilters();
          });
        }

        MATERIAL_DATA.forEach((group, groupIndex) => {
          const position = MATERIAL_CLUSTER_LAYOUT[groupIndex] || { x: 50, y: 50 };
          const cluster = document.createElement('div');
          cluster.className = 'material-cluster';
          cluster.style.left = position.x + '%';
          cluster.style.top = position.y + '%';
          cluster.dataset.categoryClass = MATERIAL_CATEGORY_CLASS[group.category] || '';

          const linksSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          linksSvg.setAttribute('class', 'cluster-links');
          linksSvg.setAttribute('viewBox', '0 0 100 100');
          linksSvg.setAttribute('preserveAspectRatio', 'none');
          cluster.appendChild(linksSvg);

          const centerNode = document.createElement('button');
          centerNode.type = 'button';
          centerNode.className = 'cluster-center';
          centerNode.textContent = group.category;
          centerNode.setAttribute('aria-label', group.category);
          cluster.appendChild(centerNode);

          const radiusPercent = window.innerWidth <= 900 ? 32 : 34;
          const itemCount = group.items.length;
          const angleOffset = (groupIndex % 2 === 0 ? -15 : 12) * Math.PI / 180;

          group.items.forEach((item, itemIndex) => {
            const angle = ((Math.PI * 2) / itemCount) * itemIndex - Math.PI / 2 + angleOffset;
            const x = 50 + Math.cos(angle) * radiusPercent;
            const y = 50 + Math.sin(angle) * radiusPercent;

            const link = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            link.setAttribute('class', 'cluster-link');
            link.setAttribute('x1', '50');
            link.setAttribute('y1', '50');
            link.setAttribute('x2', String(x));
            link.setAttribute('y2', String(y));
            linksSvg.appendChild(link);

            const node = document.createElement('button');
            node.type = 'button';
            node.className = 'cluster-orbit';
            node.textContent = item.name;
            node.style.left = x + '%';
            node.style.top = y + '%';
            node.__materialTags = getItemTags(item.name);
            node.addEventListener('click', function () {
              openMaterialModal(group.category, item);
            });
            cluster.appendChild(node);
          });

          materialGalaxyBoard.appendChild(cluster);
        });

        materialModalCloseButtons.forEach((button) => {
          button.addEventListener('click', function () {
            materialModal.hidden = true;
          });
        });

        applyMaterialFilters();

        materialGalaxyBoard.dataset.initialized = 'true';
      }

      openLinks.forEach((link) => {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          openPanel(this.dataset.panelTarget);
        });
      });

      closeButtons.forEach((button) => {
        button.addEventListener('click', function () {
          closePanels();
        });
      });

      navLinks.forEach((link) => {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          const targetId = this.dataset.target;
          showSection(targetId);
        });
      });

      loadAdaptiveImages();
      initMaterialPanel();
    })();
  </script>
</body>
</html>
